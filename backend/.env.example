# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=The Sovereign Blade API
APP_VERSION=1.0.0
ENVIRONMENT=production
SECRET_KEY=change-me-to-a-long-random-string-in-production

# ─── Database ─────────────────────────────────────────────────────────────────
# Local PostgreSQL example:
#   DATABASE_URL=postgresql://postgres:password@localhost:5432/appdb
# Neon / Supabase example (use the pooler URL for serverless):
#   DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://your-vercel-app.vercel.app
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://your-vercel-app.vercel.app

# ─── SMS/Twilio (Optional) ────────────────────────────────────────────────────
# Leave empty to disable SMS notifications
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
