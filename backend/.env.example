# ─── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string-in-production

# ─── Database ─────────────────────────────────────────────────────────────────
# Local PostgreSQL example:
#   DATABASE_URL=postgresql://postgres:password@localhost:5432/appdb
# Supabase / Neon example (use the pooler URL for serverless):
#   DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/appdb

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── SMS/Twilio (Optional) ────────────────────────────────────────────────────
# Leave empty to disable SMS notifications
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Payments/Razorpay (Optional) ────────────────────────────────────────────
# Leave empty to disable payments
# Get these from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
